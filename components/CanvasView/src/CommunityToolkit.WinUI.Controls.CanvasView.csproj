<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove(Directory.Build.props))" Condition="Exists('$([MSBuild]::GetPathOfFileAbove(Directory.Build.props))')" />
  <PropertyGroup>
    <ToolkitComponentName>CanvasView</ToolkitComponentName>
    <Description>This package contains CanvasView.</Description>
    
    <!-- Rns suffix is required for namespaces shared across projects. See https://github.com/CommunityToolkit/Labs-Windows/issues/152 -->
    <RootNamespace>CommunityToolkit.WinUI.Controls.CanvasViewRns</RootNamespace>
  </PropertyGroup>

  <!-- Sets this up as a toolkit component's source project -->
  <Import Project="$(ToolingDirectory)\ToolkitComponent.SourceProject.props" />
  
  <PropertyGroup>
    <PackageId>$(PackageIdPrefix).$(PackageIdVariant).Controls.$(ToolkitComponentName)</PackageId>
  </PropertyGroup>

  <!--
    Ensure the WINAPPSDK compilation symbol is present for WinAppSDK builds.
    CanvasViewPanel switches between Microsoft.UI.Xaml and Windows.UI.Xaml based on this symbol.
    If the symbol is missing, the panel may compile against Windows.UI.Xaml and fail at runtime
    inside WinUI 3 (InvalidCastException/E_NOINTERFACE during MeasureOverride).
  -->
  <PropertyGroup Condition="'$(IsWinAppSdk)' == 'true'">
    <DefineConstants>$(DefineConstants);WINAPPSDK</DefineConstants>
  </PropertyGroup>

  <!-- Uno WinUI 3 uses Microsoft.UI.Xaml but does not set IsWinAppSdk. Ensure WINAPPSDK is defined so CanvasViewPanel compiles against the correct XAML namespace. -->
  <PropertyGroup Condition="'$(IsUno)' == 'true' AND '$(WinUIMajorVersion)' == '3'">
    <DefineConstants>$(DefineConstants);WINAPPSDK</DefineConstants>
  </PropertyGroup>
 
  </Project>
